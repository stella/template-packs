{
  "name": "@stella/template-packs",
  "version": "0.1.0",
  "private": true,
  "description": "Legal template packs for Stella: attributed, licensed, fillable",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [],
  "scripts": {
    "validate": "bun scripts/validate.ts",
    "build-index": "bun scripts/build-index.ts",
    "check": "bun scripts/validate.ts && bun scripts/build-index.ts --check",
    "typecheck": "bun check --no-pretty --all --project=tsconfig.json"
  },
  "devDependencies": {
    "bun-types": "1.4.4",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "jszip": "^3.10.1"
  }
}
